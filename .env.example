# Optional: separate realtime host. Development defaults to port 3001;
# production defaults to the app's /api/realtime Vercel WebSocket endpoint.
# VITE_REALTIME_URL=wss://realtime.example.com
REALTIME_PORT=3001
# Comma-separated app origins; set this explicitly on a public deployment.
# REALTIME_ORIGINS=https://watch.example.com
# Vercel: provision Redis through the marketplace. Keep this server-only.
# REDIS_URL=rediss://default:password@host:6379
